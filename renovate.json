{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Chicago",
  "schedule": ["before 9am on saturday"],
  "flux": {
    "managerFilePatterns": ["/^(clusters|infrastructure|apps)/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^(infrastructure|apps)/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Majors need a manual OK from the dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Never jump MariaDB across major versions on an existing data dir",
      "matchPackageNames": ["mariadb"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["favonia/cloudflare-ddns"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}